# Secrets — never commit
.env
.env.*
!.env.example

# Client transcripts can contain credentials (an agent printed CLI tokens once,
# Codex sometimes dumps .env). Keep every log local.
*.log
*.abort
*.stdout
*.runpath
**/current-cell.txt
**/running/
**/.publish.lock
loop.pid

# Local / generated
.venv/
**/__pycache__/
**/*.pyc
node_modules/
target/
bin/
obj/
.DS_Store
*.tmp

# Per-run working copies live outside this repo (~/spike-runs)
spike-runs/
